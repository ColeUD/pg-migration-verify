{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    // A bin-only package: nothing imports its types, and maps would point at src/, which is not
    // published.
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src"]
}
